# AIC-26 Environment Configuration
# Copy this file to .env and modify as needed

# ── Data paths ──────────────────────────────────────────────
# DATA_DIR=./data
# EMBEDDING_DIR=./data/embeddings
# KEYFRAMES_DIR=./data/keyframes
# DB_PATH=./data/faiss_db.pkl          # Legacy FAISS (no longer primary)

# ── Model configuration ─────────────────────────────────────
# EVA02_MODEL_NAME=hf-hub:timm/eva02_large_patch14_clip_224.merged2b_s4b_b131k
# EVA02_PRETRAINED=laion2b_s4b_b131k

# ── Elasticsearch ────────────────────────────────────────────
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
# ES_USERNAME=elastic              # Only needed if xpack.security.enabled=true
# ES_PASSWORD=changeme             # Only needed if xpack.security.enabled=true
ES_INDEX_KEYFRAMES=aic26_keyframes
ES_INDEX_QUERIES=aic26_queries
ES_KNN_NUM_CANDIDATES=1000

# Dual embedding weights (EVA-02 + BLIP-ITM, Option C Lite)
EVA02_SEARCH_WEIGHT=0.6
BLIP2_SEARCH_WEIGHT=0.4
USE_DUAL_EMBEDDING=true

# Embedding dimensions
ES_EVA02_DIM=768
ES_BLIP_DIM=768

# ── Server configuration ────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FILE=./data/aic26.log