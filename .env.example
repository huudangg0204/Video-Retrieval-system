# AIC-26 Environment Configuration
# Copy this file to .env and modify as needed

# ── Data paths ──────────────────────────────────────────────
# ── Gemini API Configuration ───────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
# EMBEDDING_DIR=./data/embeddings
# KEYFRAMES_DIR=./data/keyframes
# DB_PATH=./data/faiss_db.pkl

# ── Model configuration ─────────────────────────────────────
# EVA02_MODEL_NAME=hf-hub:timm/eva02_large_patch14_clip_224.merged2b_s4b_b131k
# EVA02_PRETRAINED=laion2b_s4b_b131k
# CLIP32_MODEL_NAME=openai/clip-vit-base-patch32
# CLIP32_EMBEDDING_DIR=./data/clip32_embeddings
# CLIP32_SEARCH_WEIGHT=0.4
# YOLO_MODEL_NAME=yolo26x.pt

# ── Server configuration ────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FILE=./data/aic26.log
# ── Metadata extraction (per docs/specs/metadata-extraction.md) ──
# METADATA_DIR=./data/metadata
# SCENE_GRAPH_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# SCENE_GRAPH_MAX_TRIPLES=5
# SCENE_GRAPH_MAX_NEW_TOKENS=512
# SCENE_GRAPH_QUANTIZATION=4bit
# PLACES365_MODEL_NAME=efficientnet_b2_places365
# POSITION_MIN_BBOX_FRACTION=0.05
# EXTRACT_SCENE_GRAPH=true
# ── Dịch thuật Vi→En ─────────────────────────────────────────

USE_DUAL_EMBEDDING=false 
TRANSLATION_DEFAULT_MODE=test# "test" nếu không có API key
GEMINI_API_KEY=
 